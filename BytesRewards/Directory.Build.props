<Project>

  <PropertyGroup>
    <!-- Centralized Target Framework -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Nullable Reference Types -->
    <Nullable>enable</Nullable>

    <!-- Nuget Audit -->
    <NugetAudit>false</NugetAudit>

    <!-- Implicit Global Usings -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
    CS8618: Non-nullable property is uninitialized
    CS8602: Dereference of a possibly null reference
    CS8603: Possible null return from a non-nullable method
    CS8604: Possible null argument
    CS1998: Async method lacks 'await'
    CS0168: Variable declared but never used
    CS0219: Variable assigned but never used
    CS0618: Obsolete member usage
    -->
    <WarningsAsErrors>
      CS8618;CS8602;CS8603;CS8604;CS1998;CS0168;CS0219;CS0618
    </WarningsAsErrors>

    <!-- Common Assembly Info -->
    <Company>Bytestrone</Company>
    <Authors>Team AppWeaver</Authors>
    <RepositoryUrl>https://github.com/my-org/my-repo</RepositoryUrl>
    <Copyright>Copyright © 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>