{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
                "Microsoft.AspNetCore.Diagnostics.DeveloperExceptionPageMiddleware": "Fatal",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Fatal",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
                "System.Net.Http.HttpClient": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties}{NewLine}{Exception}"
                }
            },
            {
                "Name": "OpenTelemetry",
                "Args": {
                    "includeFormattedMessage": true,
                    "includeScopes": true
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "../logs/app.log",
                    "rollingInterval": "Day",
                    "shared": true,
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties}{NewLine}{NewLine}{Exception}"
                }
            }
        ]
    },
    "AuthProvider": "EntraExternalID",
    "AzureAdB2C": {
        "Instance": "",
        "Domain": "",
        "ClientId": "",
        "SignedOutCallbackPath": "",
        "SignUpSignInPolicyId": "",
        "TenantId": "",
        "Audience": ""
    },
    "EntraExternalID": {
        "TenantSubdomain": "appweaverdev",
        "Instance": "https://appweaverdev.ciamlogin.com/",
        "TenantId": "1fc7aad6-4f72-4182-85e8-0e66e8bc2815",
        "ClientId": "bc6fcfcb-e7c1-4013-9a30-d6c7da211ec5"
    },
    "Tenancy": {
        "Data": {
            "ConnectionString": "Data Source=tenancy.db",
            "StoreProvider": "Database"
        }
    },
    "ExceptionHandling": {
        "ProblemDetails": {
            "ErrorTypeBaseUrl": "https://example.com/errors",
            "IncludeCorrelationId": true,
            "EmitCorrelationIdHeader": true,
            "AddNoStoreCacheHeader": true,
            "IncludeTenantId": true,
            "IncludeTraceId": true,
            "IncludeStackTrace": true,
            "DefaultTitle": "Error",
            "DefaultStatusCode": 500
        },
        "ExceptionLogger": {
            "LogCorrelationId": true,
            "LogTenantId": true,
            "LogRequestId": true,
            "LogTimestamp": true,
            "LogTraceId": true,
            "LogStackTrace": true,
            "LogInnerException": false,
            "LogLevel": "Warning"
        }
    },
    "OpenTelemetry": {
        "ServiceName": "BytesRewards.API",
        "ServiceVersion": "1.0.0"
    },
    "KeycloakAdmin": {
        "ServerUrl": "http://localhost:8080",
        "Realm": "bytes-rewards",
        "ClientId": "bytes-rewards-api",
        "ClientSecret": "UmVauhNlmmOIrhzlR0VK7GoFtqslnFTj"
    }
}