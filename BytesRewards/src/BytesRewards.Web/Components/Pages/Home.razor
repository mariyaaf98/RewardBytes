@page "/"

<PageTitle>Home</PageTitle>

<div class="home-page">
    <div class="home-hero">
        <div class="home-hero__icon" aria-hidden="true"></div>
        <h1 class="home-hero__title">Welcome to BytesRewards</h1>
        <p class="home-hero__sub">Manage your organisation's rewards, departments, and recognitions from one place.</p>
    </div>

    <div class="home-cards">
        <a href="admin/departments" class="home-card">
            <span class="home-card__icon home-card__icon--dept" aria-hidden="true"></span>
            <div>
                <h2 class="home-card__title">Departments</h2>
                <p class="home-card__desc">Create and manage organisation departments.</p>
            </div>
        </a>

        <a href="counter" class="home-card">
            <span class="home-card__icon home-card__icon--counter" aria-hidden="true"></span>
            <div>
                <h2 class="home-card__title">Counter</h2>
                <p class="home-card__desc">Interactive counter demo component.</p>
            </div>
        </a>

        <a href="weather" class="home-card">
            <span class="home-card__icon home-card__icon--weather" aria-hidden="true"></span>
            <div>
                <h2 class="home-card__title">Weather</h2>
                <p class="home-card__desc">Live weather data from the backend API.</p>
            </div>
        </a>
    </div>
</div>
