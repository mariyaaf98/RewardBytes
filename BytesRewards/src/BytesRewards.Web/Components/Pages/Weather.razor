@page "/weather"
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject WeatherApiClient WeatherApi

<PageTitle>Weather</PageTitle>

<div class="weather-page">
    <div class="weather-header">
        <div class="weather-header__icon" aria-hidden="true"></div>
        <div>
            <h1 class="weather-header__title">Weather</h1>
            <p class="weather-header__sub">Live forecast data loaded from the backend API.</p>
        </div>
    </div>

    @if (forecasts == null)
    {
        <div class="weather-loading">
            <div class="weather-spinner" role="status" aria-label="Loading"></div>
            <span>Loading forecasts…</span>
        </div>
    }
    else if (forecasts.Length == 0)
    {
        <div class="weather-empty">
            <p>No forecast data available.</p>
        </div>
    }
    else
    {
        <!-- Summary cards (first 4 items) -->
        <div class="weather-cards">
            @foreach (var forecast in forecasts.Take(4))
            {
                <div class="weather-card">
                    <span class="weather-card__date">@forecast.Date.ToString("MMM d")</span>
                    <span class="weather-card__temp">@forecast.TemperatureC°<small>C</small></span>
                    <span class="weather-card__tempf">@forecast.TemperatureF°F</span>
                    <span class="weather-card__summary">@forecast.Summary</span>
                </div>
            }
        </div>

        <!-- Full table -->
        <div class="weather-table-wrap">
            <table class="weather-table" aria-label="Weather forecast table">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Temp (°C)</th>
                        <th scope="col">Temp (°F)</th>
                        <th scope="col">Summary</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var forecast in forecasts)
                    {
                        <tr>
                            <td>@forecast.Date.ToShortDateString()</td>
                            <td><strong>@forecast.TemperatureC°C</strong></td>
                            <td class="weather-table__muted">@forecast.TemperatureF°F</td>
                            <td>
                                <span class="weather-badge">@forecast.Summary</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        forecasts = await WeatherApi.GetWeatherAsync();
    }
}
