<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Package sources -->
  <packageSources>
    <!-- Official NuGet feed -->
    <add key="nuget.org" 
      value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- AppWeaver Framework feed (Azure Artifacts) -->
    <add key="appweaver-framework" 
      value="https://pkgs.dev.azure.com/bytestrone-labs/_packaging/appweaver-framework/nuget/v3/index.json" />

    <!-- Example: Public feed (uncomment if needed) -->
    <!-- <add key="PublicFeed" 
        value="https://nuget.mycompany.com/v3/index.json" /> -->
  </packageSources>

  <!-- ⚠️ TEMPORARY: Embedded PAT for internal testing only -->
  <packageSourceCredentials>
    <appweaver-framework>
      <add key="Username" value="az" />
      <add key="ClearTextPassword" value="3Y3Qt9ebjY8xMFFpZXCkYSwNkC1mDJ3Kk5OekZy52ZVzQ1FgH5R3JQQJ99BJACAAAAAj3gtBAAASAZDO1vsR" />
    </appweaver-framework>
  </packageSourceCredentials>

  <!-- Package source mapping for security -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Aspire.*" />
      <package pattern="Microsoft.*" />
      <package pattern="OpenTelemetry.*" />
    </packageSource>
    <packageSource key="appweaver-framework">
      <package pattern="AppWeaver.*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Recommended: Enable package signature verification -->
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>

</configuration>

